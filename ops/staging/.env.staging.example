# SAMPLE PLACEHOLDERS — NEVER boot with these values.
# Create .env.staging only on the approved server, never in Git.
APP_NAME="Imagine Universidade Staging"
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://REPLACE_WITH_APPROVED_HTTPS_STAGING_HOST
APP_KEY=REPLACE_WITH_PRIVATE_LARAVEL_KEY
UNI_STAGING_LOOPBACK_PORT=REPLACE_WITH_EXCLUSIVE_VERIFIED_LOOPBACK_PORT
UNI_STAGING_DB=imagine_uni_stage
UNI_STAGING_DB_OWNER=uni_stage_migration_owner
UNI_STAGING_DB_OWNER_PASSWORD=REPLACE_WITH_PRIVATE_DB_OWNER_SECRET
UNI_STAGING_APP_DB_USER=uni_stage_runtime
UNI_STAGING_APP_DB_PASSWORD=REPLACE_WITH_PRIVATE_RUNTIME_DB_SECRET
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=imagine_universidade_staging_session
LOG_CHANNEL=stderr
LOG_LEVEL=warning
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
