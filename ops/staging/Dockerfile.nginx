FROM nginx@sha256:caf4e1e032a20f9c3c5e28fc7f25ffd768ad8677b4975c54193075997b3a97e3
# Private QA security remediation: Alpine v3.24 libxml2 2.13.9-r3
# addresses the HIGH vendor advisory reported for 2.13.9-r2 in the exact local build.
# Keep the repository pinned to v3.24; never enable edge or grant runtime privileges.
RUN apk add --no-cache 'libxml2=2.13.9-r3'
# Nginx never receives Laravel source files, sessions or env secrets.
COPY public/ /var/www/html/public/
COPY ops/staging/nginx.conf /etc/nginx/conf.d/default.conf
USER nginx
EXPOSE 8080
